 RowBox[{
  RowBox[{"\[CapitalPi]exact", "=", 
   RowBox[{"Function", "[", 
    RowBox[{"d", ",", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"y", " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "\[Rho]"}], 
           RowBox[{"(", 
            RowBox[{"1", "-", "y", "+", "\[Delta]"}], ")"}]}]], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "-", "y"}], ")"}], 
          RowBox[{"\[Theta]", "-", "1"}]], " ", 
         SuperscriptBox["\[Rho]", "\[Theta]"], " ", 
         RowBox[{"\[Psi]", "[", 
          RowBox[{"\[Theta]", ",", 
           RowBox[{
            SuperscriptBox["\[Rho]", "2"], 
            RowBox[{"(", 
             RowBox[{"1", "-", "y"}], ")"}], " ", "\[Delta]"}]}], " ", 
          "]"}]}], "//.", 
        RowBox[{"pp", "[", "d", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "0", ",", "1"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalPi]L", "=", 
   RowBox[{"Function", "[", 
    RowBox[{"d", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          SqrtBox["2"], 
          RowBox[{
           SqrtBox["\[Pi]"], " ", 
           SubscriptBox["R", "k"]}]], "+", " ", 
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           FractionBox[
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               FractionBox["n", 
                RowBox[{"2", 
                 SubscriptBox["R", "k"]}]], "+", " ", "d", "-", 
               SubscriptBox["R", "k"]}], ")"}], "2"], "2"]], " ", 
          RowBox[{"Erfc", "[", 
           RowBox[{
            FractionBox["1", 
             SqrtBox["2"]], 
            RowBox[{"(", 
             RowBox[{
              FractionBox["n", 
               RowBox[{"2", 
                SubscriptBox["R", "k"]}]], "+", "d", "-", 
              SubscriptBox["R", "k"]}], ")"}]}], "]"}], " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            FractionBox["d", 
             SubscriptBox["R", "k"]], "-", 
            FractionBox["n", 
             RowBox[{"2", " ", 
              SubsuperscriptBox["R", "k", "2"]}]]}], ")"}]}]}], ")"}], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          SubscriptBox["R", "k"], "d"], ")"}], 
        RowBox[{
         FractionBox[
          RowBox[{"n", "-", "1"}], "2"], " "}]], 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", "2"]}], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"d", "-", 
            SubscriptBox["R", "k"]}], ")"}], "2"]}]]}], "//.", 
      RowBox[{"pp", "[", "d", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalPi]G", "=", 
   RowBox[{"Function", "[", 
    RowBox[{"d", ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"\[Mu]", "+", 
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"-", 
             FractionBox[
              SuperscriptBox["\[Mu]", "2"], 
              RowBox[{"2", " ", 
               SuperscriptBox["\[Sigma]", "2"]}]]}]], " ", 
           SqrtBox[
            FractionBox["2", "\[Pi]"]], " ", "\[Sigma]"}], "+", 
          RowBox[{"\[Mu]", " ", 
           RowBox[{"Erf", "[", 
            FractionBox["\[Mu]", 
             RowBox[{
              SqrtBox["2"], " ", "\[Sigma]"}]], "]"}]}]}], ")"}]}], "/.", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"\[Mu]", "->", 
          RowBox[{"1", "-", 
           FractionBox[
            RowBox[{
             SuperscriptBox["d", "2"], "+", "n"}], 
            SubsuperscriptBox["R", "k", "2"]]}]}], " ", ",", " ", 
         RowBox[{"\[Sigma]", "->", 
          SqrtBox[
           FractionBox[
            RowBox[{
             RowBox[{"2", " ", "n"}], "+", 
             RowBox[{"4", " ", 
              SuperscriptBox["d", "2"]}]}], 
            SubsuperscriptBox["R", "k", "4"]]]}]}], "}"}]}], "//.", 
      RowBox[{"pp", "[", "d", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalPi]approx", "=", 
   RowBox[{"Function", "[", 
    RowBox[{"d", ",", 
     RowBox[{
      RowBox[{"Min", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[CapitalPi]L", "[", "d", "]"}], ",", 
         RowBox[{"\[CapitalPi]G", "[", "d", "]"}]}], "}"}], "]"}], "//.", 
      RowBox[{"pp", "[", "d", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rr", "=", 
   RowBox[{"Function", "[", 
    RowBox[{"d", ",", 
     RowBox[{
      RowBox[{"1", "-", 
       FractionBox[
        SuperscriptBox["d", "2"], 
        SubscriptBox["R", "k"]]}], "//.", 
      RowBox[{"pp", "[", "d", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Pinf", "=", 
   RowBox[{"1", "-", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "q"}], 
      RowBox[{"(", 
       RowBox[{"r", "+", 
        SqrtBox[
         RowBox[{
          RowBox[{"2", " ", "\[Alpha]", " ", "\[Nu]"}], "+", "1"}]], "+", 
        SqrtBox[
         RowBox[{
          RowBox[{"2", "\[Nu]"}], "+", 
          SuperscriptBox["r", "2"]}]], "-", "1"}], ")"}]}]]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[DoubleStruckCapitalP]infapprox", "=", 
   RowBox[{"Function", "[", 
    RowBox[{"d", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Pinf", "/.", 
        RowBox[{"r", "->", 
         RowBox[{"rr", "[", "d", "]"}]}]}], "/.", 
       RowBox[{"\[Nu]", "->", 
        RowBox[{"2", "U", " ", 
         RowBox[{"\[CapitalPi]approx", "[", "d", "]"}]}]}]}], "//.", 
      RowBox[{"pp", "[", "d", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[DoubleStruckCapitalP]infL", "=", 
   RowBox[{"Function", "[", 
    RowBox[{"d", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Pinf", "/.", 
        RowBox[{"r", "->", 
         RowBox[{"rr", "[", "d", "]"}]}]}], "/.", 
       RowBox[{"\[Nu]", "->", 
        RowBox[{"2", "U", " ", 
         RowBox[{"\[CapitalPi]L", "[", "d", "]"}]}]}]}], "//.", 
      RowBox[{"pp", "[", "d", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[DoubleStruckCapitalP]infG", "=", 
   RowBox[{"Function", "[", 
    RowBox[{"d", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Pinf", "/.", 
        RowBox[{"r", "->", 
         RowBox[{"rr", "[", "d", "]"}]}]}], "/.", 
       RowBox[{"\[Nu]", "->", 
        RowBox[{"2", "U", " ", 
         RowBox[{"\[CapitalPi]G", "[", "d", "]"}]}]}]}], "//.", 
      RowBox[{"pp", "[", "d", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[DoubleStruckCapitalP]infexact", "=", 
   RowBox[{"Function", "[", 
    RowBox[{"d", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Pinf", "/.", 
        RowBox[{"r", "->", 
         RowBox[{"rr", "[", "d", "]"}]}]}], "/.", 
       RowBox[{"\[Nu]", "->", 
        RowBox[{"2", "U", " ", 
         RowBox[{"\[CapitalPi]exact", "[", "d", "]"}]}]}]}], "//.", 
      RowBox[{"pp", "[", "d", "]"}]}]}], "]"}]}], ";"}]}], "Input",
