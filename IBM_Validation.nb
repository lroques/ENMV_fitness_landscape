    RowBox[{"\[Theta]", "-", 
     FractionBox["1", "2"]}]]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "it", " ", "is", " ", "dominated", " ", "by", " ", "the", " ", "value", " ",
    "near", " ", "the", " ", "maximum", " ", "of", " ", "the", " ", 
