Cell[BoxData[{
 RowBox[{
  RowBox[{"*", " ", "sampling", " ", "of", " ", 
   SubscriptBox["\[CapitalNu]", "0"], " ", "copies", " ", "from", " ", 
   "source", " ", 
   RowBox[{"(", 
    RowBox[{"fixed", " ", "across", " ", "source", " ", "species"}], ")"}]}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{"*", " ", "each", " ", "with", " ", "proba", " ", 
  SubscriptBox["p", 
   RowBox[{"k", " "}]], "to", " ", "successfully", " ", "infect", " ", 
  "target", " ", "k"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"*", " ", 
    SubscriptBox["\[CapitalNu]", "0"]}], ">>", 
   RowBox[{"1", " ", "and", " ", 
    SubscriptBox["p", "k"], 
    RowBox[{"<<", "1"}], " ", "poisson", " ", 
    RowBox[{"limit", ":", " ", 
     RowBox[{
      SubscriptBox["n", 
       RowBox[{"0", ",", "k"}]], "\[Distributed]", 
      RowBox[{
       RowBox[{"Poisson", "[", 
        RowBox[{
         SubscriptBox["N", "0"], 
         SubscriptBox["p", "k"]}], "]"}], " ", "sucessful", " ", 
       "infections"}]}]}]}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"after", " ", "inoculation", " ", "of", " ", 
   SubscriptBox["n", 
    RowBox[{"0", ",", "k"}]], "virions"}], ",", 
  RowBox[{
  "each", " ", "having", " ", "independent", " ", "establishment", " ", 
   "proba", " ", 
   RowBox[{"\[Pi]", "[", 
    RowBox[{"j", ",", "k"}], "]"}], 
   RowBox[{"(", 
    RowBox[{"branching", "property"}], ")"}]}]}], "\n", 
 RowBox[{
  RowBox[{
  "the", " ", "proba", " ", "of", " ", "establishment", " ", "from", " ", 
   "all", " ", "copies", " ", "inoculated", " ", "from", " ", "source", " ", 
   "j", " ", "in", " ", "host", " ", "k", " ", 
   RowBox[{"is", ":", "\[IndentingNewLine]", 
    RowBox[{
     SubscriptBox["\[DoubleStruckCapitalP]", "EST"], "[", 
     RowBox[{"j", ",", "k"}], "]"}]}]}], "=", 
  RowBox[{
   SubscriptBox["\[DoubleStruckCapitalE]", 
    SubscriptBox["n", 
     RowBox[{"0", ",", "k"}]]], "[", 
   RowBox[{"1", "-", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"\[Pi]", "[", 
        RowBox[{"j", ",", "k"}], "]"}]}], ")"}], 
     SubscriptBox["n", 
      RowBox[{"0", ",", "k"}]]]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"we", " ", 
    RowBox[{"have", " ", ":", " ", 
     RowBox[{"\[Pi]", "[", 
      RowBox[{"j", ",", "k"}], "]"}]}]}], "=", 
   RowBox[{"1", "-", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "2"}], " ", 
      SubscriptBox["\[Xi]", "k"], 
      SubsuperscriptBox["r", 
       RowBox[{"j", ",", "k"}], "*"]}]]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"let", " ", 
     SubscriptBox["q", "k"]}], "=", 
