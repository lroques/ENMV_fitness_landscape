Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"as", " ", "B"}], "\[Rule]", "\[Infinity]"}], ",", " ", 
   RowBox[{"X", "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", 
       SuperscriptBox["z", "B"]], "-", 
      RowBox[{"1", "~", 
       FractionBox["1", 
        SuperscriptBox["z", "B"]]}]}], 
     UnderscriptBox["->", GridBox[{
        {
         RowBox[{"0", " ", "<", " ", "z", " ", "<", " ", "1"}]},
        {
         RowBox[{"B", " ", "->", " ", "\[Infinity]"}]}
       }]], 
     RowBox[{
      RowBox[{
      "\[Infinity]", "  ", "and", " ", "the", " ", "hypergeometric", " ", 
       "term", " ", 
       RowBox[{"vanishes", ":", "\[IndentingNewLine]", " ", 
        RowBox[{
         RowBox[{
          SubscriptBox["P", "\[ScriptM]"], "[", "z", "]"}], 
         UnderscriptBox["~", 
          RowBox[{"X", " ", "->", " ", "\[Infinity]"}]], 
         FractionBox[
          RowBox[{"B", " ", 
           SuperscriptBox["X", 
            RowBox[{
             RowBox[{"-", "1"}], "/", "B"}]]}], 
          RowBox[{"1", "+", "B", "-", "c"}]]}]}]}], 
      UnderscriptBox["->", GridBox[{
         {
          RowBox[{"0", " ", "<", " ", "z", " ", "<", " ", "1"}]},
         {
          RowBox[{"B", " ", "->", " ", "\[Infinity]"}]}
        }]], 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{"B", " "}], 
         RowBox[{"1", "+", "B", "-", "c"}]], "z"}], "\[Proportional]", 
       "z"}]}]}]}]}],
  Background->RGBColor[1, 1, 0]]], "Text",
