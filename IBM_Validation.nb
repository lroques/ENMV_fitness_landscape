Cell[BoxData[
 RowBox[{
  RowBox[{"When", " ", 
   SubscriptBox["R", "k"], " ", "is"}], " ", "<=", 
  RowBox[{"1", "  ", "and", " ", "q", " ", "is", " ", "small", " ", 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["R", "k"], "=", 
     RowBox[{
      RowBox[{"0.9", " ", "and", " ", 
       SubscriptBox["q", "k"]}], "=", 
      RowBox[{"0.5", " ", "or", " ", "5", " ", "below"}]}]}], ")"}], " ", 
   "the", " ", "maching", " ", "approx", " ", "is", " ", "less", " ", 
   "accurate", " ", "but", " ", "still", " ", "reasonable"}]}]], "Text",
