Cell[BoxData[
 RowBox[{"when", " ", 
  SubscriptBox["q", "k"], " ", "is", " ", "large", " ", "it", " ", "suffices",
   " ", "to", " ", "have", " ", "the", " ", "Laplace", " ", 
  "approx"}]], "Text",
 CellChangeTimes->{{3.9820383764567757`*^9, 
  3.982038392175516*^9}},ExpressionUUID->"83c64905-cc5c-3d4d-9955-\
5a4896ab7979"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"but", " ", "when", " ", 
   SubscriptBox["q", "k"], " ", "is", " ", "small", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
     "so", " ", "that", " ", "establishment", " ", "is", " ", "certain", " ", 
      "even", " ", "if", " ", 
      SubscriptBox["d", "jk"]}], "=", 
     RowBox[{
      SubscriptBox["d", "jj"], "=", "0"}]}], ")"}], " ", "then", " ", "the", 
   " ", "macthing", "  ", "is", " ", "better", " ", "than", " ", "the", " ", 
   "laplace"}], " "}], "\[IndentingNewLine]", 
 RowBox[{"(", 
  RowBox[{
   RowBox[{
   "because", " ", "the", " ", "Gaussian", " ", "is", " ", "more", " ", 
    "accurate", " ", "near", " ", "d"}], "=", "0"}], ")"}]}], "Text",
 CellChangeTimes->{{3.9820384086508846`*^9, 
  3.982038478142519*^9}},ExpressionUUID->"31404892-53c0-5b41-bdfb-\
bd61165d90b6"],

