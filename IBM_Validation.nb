     RowBox[{
      RowBox[{"O", "[", "1", "]"}], " ", "while", " ", 
      SubscriptBox["\[CapitalNu]", "0"]}]}]}], ">>", "1"}], ",", " ", 
  RowBox[{
   SubscriptBox["p", "k"], 
   RowBox[{"<<", "1"}], " ", "and", " ", 
   SubscriptBox["\[Xi]", "k"], 
   RowBox[{"<<", "1"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"to", " ", "leading", " ", "order", " ", "the", " ", "probability", 
  " ", "of", " ", "at", " ", "least", " ", "one", " ", "establishment", " ", 
  RowBox[{"is", ":", " "}]}]}], "Text",
