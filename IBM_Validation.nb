          RowBox[{"1", "+", 
           RowBox[{"2", "x"}]}]], 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"-", "x"}]]}]}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"\[DoubleStruckCapitalP]", "[", 
       RowBox[{
        OverscriptBox["DN", "_"], ",", 
        OverscriptBox["EST", "_"]}], "]"}], "->", 
      RowBox[{"Exp", "[", 
