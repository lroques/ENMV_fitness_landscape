Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"fs", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"1", "-", 
     FractionBox[
      RowBox[{
       SubsuperscriptBox["d", 
        RowBox[{"j", ",", "k"}], "2"], "+", "n"}], 
      SubsuperscriptBox["R", "k", "2"]]}], "==", 
    RowBox[{"Expectation", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         FractionBox["1", 
          SubsuperscriptBox["R", "k", "2"]], 
         RowBox[{
          SubsuperscriptBox["\[Chi]", "n", "2"], "[", 
          SubsuperscriptBox["d", 
           RowBox[{"j", ",", "k"}], "2"], "]"}]}]}], ")"}], ",", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["\[Chi]", "n", "2"], "[", 
        SubsuperscriptBox["d", 
         RowBox[{"j", ",", "k"}], "2"], "]"}], "\[Distributed]", 
       RowBox[{"NoncentralChiSquareDistribution", "[", 
        RowBox[{"n", ",", 
         SubsuperscriptBox["d", 
          RowBox[{"j", ",", "k"}], "2"]}], "]"}]}], ",", 
      RowBox[{"Assumptions", "->", "conds"}]}], "]"}]}], ",", "conds"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"fs", "[", 
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"2", " ", "n"}], "+", 
      RowBox[{"4", " ", 
       SubsuperscriptBox["d", 
        RowBox[{"j", ",", "k"}], "2"]}]}], 
     SubsuperscriptBox["R", "k", "4"]], "==", 
    RowBox[{"Expectation", "[", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{
           FractionBox["1", 
            SubsuperscriptBox["R", "k", "2"]], 
           RowBox[{
            SubsuperscriptBox["\[Chi]", "n", "2"], "[", 
            SubsuperscriptBox["d", 
             RowBox[{"j", ",", "k"}], "2"], "]"}]}]}], ")"}], "2"], "-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", 
          FractionBox[
           RowBox[{
            SubsuperscriptBox["d", 
             RowBox[{"j", ",", "k"}], "2"], "+", "n"}], 
           SubsuperscriptBox["R", "k", "2"]]}], ")"}], "2"]}], ",", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["\[Chi]", "n", "2"], "[", 
        SubsuperscriptBox["d", 
         RowBox[{"j", ",", "k"}], "2"], "]"}], "\[Distributed]", 
       RowBox[{"NoncentralChiSquareDistribution", "[", 
        RowBox[{"n", ",", 
         SubsuperscriptBox["d", 
          RowBox[{"j", ",", "k"}], "2"]}], "]"}]}], ",", 
      RowBox[{"Assumptions", "->", "conds"}]}], "]"}]}], ",", "conds"}], 
  "]"}]}], "Input",
