Cell["\<\
compared  to  the  exact  integrand, the first order is still better than the \
zeroth order\
\>", "Text",
 CellChangeTimes->{{3.981957648036625*^9, 3.9819576536359196`*^9}, {
  3.981957742417314*^9, 
  3.981957751576563*^9}},ExpressionUUID->"3f78e42c-fc3f-be47-854c-\
e4fb6f7a245b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"y", " ", 
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{
              RowBox[{"-", "\[Rho]"}], 
              RowBox[{"(", 
               RowBox[{"1", "-", "y", "+", "\[Delta]"}], ")"}]}]], " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1", "-", "y"}], ")"}], 
             RowBox[{"\[Theta]", "-", "1"}]], " ", 
            SuperscriptBox["\[Rho]", "\[Theta]"], " ", 
            RowBox[{"\[Psi]", "[", 
             RowBox[{"\[Theta]", ",", 
              RowBox[{
               SuperscriptBox["\[Rho]", "2"], 
               RowBox[{"(", 
                RowBox[{"1", "-", "y"}], ")"}], " ", "\[Delta]"}]}], " ", 
             "]"}]}], "/.", 
           RowBox[{"y", "->", 
            RowBox[{"Y", "[", "x", "]"}]}]}], "/.", "y2x"}], ",", 
         RowBox[{"K", " ", "x", " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"-", 
            FractionBox[
             RowBox[{"x", " ", "\[Theta]"}], "2"]}]], 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", 
             FractionBox["1", "4"]}], " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"x", "+", "xD"}], ")"}], "2"], " ", "\[Rho]"}]]}], ",", 
         RowBox[{"K", " ", "x", " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", 
             FractionBox["1", "4"]}], " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"x", "+", "xD"}], ")"}], "2"], " ", "\[Rho]"}]]}]}], 
        "}"}], "/.", 
       RowBox[{"K", "->", 
        FractionBox[
         RowBox[{" ", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "+", 
              FractionBox["xD", "2"]}], ")"}], 
            RowBox[{
             FractionBox["1", "2"], "-", "\[Theta]"}]], 
           SqrtBox["\[Rho]"]}]}], 
         RowBox[{"2", " ", 
          SqrtBox["\[Pi]"]}]]}]}], "/.", 
      RowBox[{"xD", "->", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{
          SqrtBox["\[Delta]"], "-", "1"}], ")"}]}]}]}], "//.", "pars"}], 
    "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "2"}], "}"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Green", ",", 
        RowBox[{"Opacity", "[", "0.5", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"Dashed", ",", "Red"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"Dotted", ",", "Black"}], "}"}]}], "}"}]}]}], "]"}]], "Input",
