Cell[CellGroupData[{

Cell["host specific demographic variance during  infection", "Subsubsection",
 CellChangeTimes->{{3.9817800282198524`*^9, 3.9817800478992424`*^9}, {
  3.981782825830389*^9, 
  3.981782831609995*^9}},ExpressionUUID->"804c2778-aeb2-244a-9392-\
491524754be3"],

Cell[BoxData[{
 RowBox[{"we", " ", "assume", " ", "that", " ", "uin", " ", "host", " ", "k", 
  " ", "the", " ", "infection", " ", "process", " ", "implies", " ", 
  "stochastic", " ", "variance", " ", 
  SubscriptBox["\[Sigma]", "k"], " ", 
  RowBox[{"(", 
   RowBox[{"independent", " ", "of", " ", "types"}], 
   ")"}]}], "\[IndentingNewLine]", 
 RowBox[{"this", "  ", 
  SubscriptBox["\[Sigma]", "k"], " ", "is", " ", "due", " ", "generated", " ",
   "by", " ", "the", " ", "complex", " ", "process", " ", "of", " ", 
  "infection", " ", "within", " ", "cells", " ", "and", " ", "succesive", " ",
   "bottlenecks", " ", "acrosss", " ", "cells"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"baded", " ", "on", " ", "Wahl"}], " ", "&"}], " ", "Gerrish", " ",
   "2001", " ", "we", " ", "conjecture", " ", "that", " ", "this", " ", 
  "boils", " ", "down", " ", "to", " ", "a", " ", "genotype", " ", "indep", 
  " ", 
  SubscriptBox["\[Sigma]", "k"], " ", "for", " ", "host", " ", 
  "k"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "the", " ", "establishment", " ", "proba", " ", "per", " ", "inoculated", 
   " ", "virion", " ", "under", " ", "the", " ", "feller", " ", "approx", " ", 
   RowBox[{"is", " ", ":", 
    RowBox[{"\[Pi]", "[", 
     RowBox[{
      SubscriptBox["x", "i"], ",", "k"}], "]"}]}]}], "=", 
  RowBox[{
   RowBox[{"\[CapitalTheta]", "[", 
    RowBox[{"r", "[", 
     RowBox[{
      SubscriptBox["x", "i"], ",", "k"}], "]"}], "]"}], 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "2"}], 
       FractionBox[
        RowBox[{"r", "[", 
         RowBox[{
          SubscriptBox["x", "i"], ",", "k"}], "]"}], 
        SubscriptBox["\[Sigma]", "k"]]}]]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  SubscriptBox["\[Sigma]", "k"], " ", "and", " ", 
  RowBox[{"r", "[", 
   RowBox[{
    SubscriptBox["x", "i"], ",", "k"}], "]"}], " ", "are", " ", "homogeneous",
   " ", "to", " ", "rates", " ", "per", " ", "unit", " ", "time", " ", 
  RowBox[{"(", 
   RowBox[{"eg", " ", "per", " ", "hour"}], ")"}]}], "\[IndentingNewLine]", 
 RowBox[{"we", " ", "scale", " ", "time", " ", "by", " ", "the", " ", 
  "maximal", " ", "possible", " ", "growth", " ", "rate", " ", "in", " ", 
  "host", " ", 
  RowBox[{"k", ":", " ", 
   RowBox[{
    RowBox[{
     SubscriptBox["r", "max"], "[", "k", "]"}], ">", "0"}]}]}]}], "Text",
 CellChangeTimes->{{3.981782778239666*^9, 3.981783033827404*^9}, {
  3.981783104813242*^9, 3.981783147500263*^9}, {3.98178926883881*^9, 
  3.9817892928541145`*^9}},ExpressionUUID->"5f9c6c11-0fd9-df46-beca-\
459dc8a36996"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"r", "[", 
    RowBox[{"x", ",", "k"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["r", "max"], "[", "k", "]"}], 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "-", 
          SubscriptBox["o", "k"]}], ")"}], "2"], 
       SubsuperscriptBox["R", "k", "2"]]}], ")"}]}]}], 
  "  "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"establishment", " ", 
   RowBox[{"proba", ":", "\[IndentingNewLine]", 
    RowBox[{"\[Pi]", "[", 
     RowBox[{
      StyleBox["x",
       FontWeight->"Bold"], ",", "k"}], "]"}]}]}], "=", 
  RowBox[{"1", "-", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "2"}], " ", 
      SubscriptBox["\[Xi]", "k"], 
      RowBox[{"\[Rho]", "[", 
       RowBox[{"x", ",", "k"}], "]"}]}]], " ", 
    "where"}]}]}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"\[Rho]", "[", 
    RowBox[{"x", ",", "k"}], "]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"r", "[", 
      RowBox[{"x", ",", "k"}], "]"}], 
     RowBox[{
      SubscriptBox["r", "max"], "[", "k", "]"}]], "=", 
    RowBox[{"1", "-", 
     RowBox[{
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          StyleBox["x",
           FontWeight->"Bold"], "-", 
          SubscriptBox[
           StyleBox["o",
            FontWeight->"Bold"], "k"]}], ")"}], "2"], 
       SubsuperscriptBox["R", "k", "2"]], " ", "is", " ", "a", " ", "scale", 
      " ", "free", "  ", "host", " ", "k", " ", "*", " ", "type", " ", 
      StyleBox["x",
       FontWeight->"Bold"], " ", "specific", " ", "growth", " ", 
      "rate"}]}]}]}], " "}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   SubscriptBox["\[Xi]", "k"], "=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{
       SubscriptBox["r", "max"], "[", "k", "]"}], 
      SubscriptBox["\[Sigma]", "k"]], " ", "is", " ", "a", " ", "scale"}], 
    "-", 
    RowBox[{
    "free", " ", "host", " ", "specific", " ", "demographic", " ", "variance",
      " ", 
     RowBox[{"(", 
      RowBox[{"in", " ", "rescaled", " ", "time"}], ")"}]}]}]}]}]}], "Text",
 CellChangeTimes->{{3.981783041331389*^9, 3.981783099615101*^9}, {
  3.981783157419073*^9, 3.981783285129515*^9}, {3.9817835642321014`*^9, 
