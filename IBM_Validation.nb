Cell[BoxData[{
 RowBox[{
  RowBox[{"probas", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"\[DoubleStruckCapitalP]", "[", 
       OverscriptBox["EST", "_"], "]"}], "->", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"\[CapitalTheta]", "[", "r", "]"}], 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", "2"}], " ", "q", " ", "r"}]]}], ")"}]}]}]}], ",", 
     RowBox[{
      RowBox[{"\[DoubleStruckCapitalP]", "[", 
       OverscriptBox["SV", "_"], "]"}], "->", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "q"}], " ", "\[Nu]"}]]}], 
     RowBox[{"(*", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "q"}], " ", 
        RowBox[{"(", 
         RowBox[{
          SqrtBox[
           RowBox[{"1", "+", 
            RowBox[{"2", " ", "\[Nu]"}]}]], "-", "1"}], ")"}]}]], "*)"}], ",", 
     RowBox[{
      RowBox[{"\[DoubleStruckCapitalP]", "[", 
       RowBox[{
        OverscriptBox["DN", "_"], ",", 
        OverscriptBox["EST", "_"]}], "]"}], "->", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "q"}], " ", 
        RowBox[{"Abs", "[", "r", "]"}], 
        RowBox[{"(", 
         RowBox[{
          SqrtBox[
           RowBox[{"1", "+", 
            RowBox[{"2", " ", 
             FractionBox["\[Nu]", 
              SuperscriptBox["r", "2"]]}]}]], "-", "1"}], ")"}]}]]}]}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
