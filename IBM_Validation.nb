}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{"pdf", " ", ":", " ", 
   RowBox[{"f", "[", "y", "]"}]}], "=", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[Rho]"}], 
     RowBox[{"(", 
      RowBox[{"1", "-", "y", "+", "\[Delta]"}], ")"}]}]], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "-", "y"}], ")"}], 
    RowBox[{"\[Theta]", "-", "1"}]], " ", 
   SuperscriptBox["\[Rho]", "\[Theta]"], " ", 
   RowBox[{"\[Psi]", "[", 
    RowBox[{"\[Theta]", ",", 
     RowBox[{
      SuperscriptBox["\[Rho]", "2"], 
      RowBox[{"(", 
       RowBox[{"1", "-", "y"}], ")"}], " ", "\[Delta]"}]}], " ", 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"with", " ", "\[Psi]"}], "=", 
  "Hypergeometric0F1Regularized"}]}], "Text",
 CellChangeTimes->{{3.981912752269394*^9, 3.98191275646863*^9}, {
  3.9819137103546906`*^9, 3.9819137154578857`*^9}, {3.9819160224602394`*^9, 
  3.981916028111599*^9}},ExpressionUUID->"a1bbbbad-8d7f-b64c-bb42-\
1a25cc3d1c7f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fs", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "\[Rho]"}], 
         RowBox[{"(", 
          RowBox[{"1", "-", "y", "+", "\[Delta]"}], ")"}]}]], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", "y"}], ")"}], 
        RowBox[{"\[Theta]", "-", "1"}]], " ", 
       SuperscriptBox["\[Rho]", "\[Theta]"], " ", 
       RowBox[{"\[Psi]", "[", 
        RowBox[{"\[Theta]", ",", 
         RowBox[{
          SuperscriptBox["\[Rho]", "2"], 
          RowBox[{"(", 
           RowBox[{"1", "-", "y"}], ")"}], " ", "\[Delta]"}]}], " ", "]"}]}], 
      "==", 
      RowBox[{"Expectation", "[", 
       RowBox[{
        RowBox[{"DiracDelta", "[", 
         RowBox[{"y", "-", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{
             FractionBox["1", 
              SubsuperscriptBox["R", "k", "2"]], 
             RowBox[{
              SubsuperscriptBox["\[Chi]", "n", "2"], "[", 
              SubsuperscriptBox["d", 
               RowBox[{"j", ",", "k"}], "2"], "]"}]}]}], ")"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{
          SubsuperscriptBox["\[Chi]", "n", "2"], "[", 
          SubsuperscriptBox["d", 
           RowBox[{"j", ",", "k"}], "2"], "]"}], "\[Distributed]", 
         RowBox[{"NoncentralChiSquareDistribution", "[", 
          RowBox[{"n", ",", 
           SubsuperscriptBox["d", 
            RowBox[{"j", ",", "k"}], "2"]}], "]"}]}], ",", 
        RowBox[{"Assumptions", "->", "conds"}]}], "]"}]}], "/.", "repar"}], "/.", 
    RowBox[{"\[Psi]", "->", "Hypergeometric0F1Regularized"}]}], ",", 
   "conds"}], "]"}]], "Input",
 CellChangeTimes->{{3.981912572255537*^9, 3.981912706305567*^9}, {
   3.9819137179397106`*^9, 3.98191372647991*^9}, 3.981954507668272*^9, {
   3.982246955169693*^9, 
   3.982246956505665*^9}},ExpressionUUID->"73b2a797-ce6b-434a-96b3-\
15fbd61c9830"],

