Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"repar", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubscriptBox["d", 
       RowBox[{"j", ",", "k"}]], "->", 
      SqrtBox[
       RowBox[{"2", "\[Delta]", " ", "\[Rho]"}]]}], ",", 
     RowBox[{
      SubscriptBox["R", "k"], "->", 
      SqrtBox[
       RowBox[{"2", "\[Rho]"}]]}], ",", 
     RowBox[{"n", "->", 
      RowBox[{"2", "\[Theta]"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"conds", "=", 
   RowBox[{
    RowBox[{"y", "<", "1"}], "&&", 
    RowBox[{"\[Rho]", ">", "0"}], "&&", 
    RowBox[{"\[Theta]", ">=", 
     FractionBox["1", "2"]}], "&&", 
    RowBox[{"\[Delta]", ">", "1"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{"1", "-", 
    RowBox[{
     FractionBox["1", 
      SubsuperscriptBox["R", "k", "2"]], 
     RowBox[{
      SubsuperscriptBox["\[Chi]", "n", "2"], "[", 
      SubsuperscriptBox["d", 
       RowBox[{"j", ",", "k"}], "2"], "]"}]}]}], ")"}], "/.", 
  "repar"}]}], "Input",
 CellChangeTimes->{{3.9819123701089077`*^9, 3.981912411164097*^9}, {
  3.981912448572014*^9, 3.981912552963129*^9}, {3.9822469518494396`*^9, 
  3.982246952103153*^9}},ExpressionUUID->"1bfa9440-fce0-f04d-b4c4-\
60338a264317"],

Cell[BoxData[
 RowBox[{"1", "-", 
  FractionBox[
   RowBox[{
    SubsuperscriptBox["\[Chi]", 
     RowBox[{"2", " ", "\[Theta]"}], "2"], "[", 
    RowBox[{"2", " ", "\[Delta]", " ", "\[Rho]"}], "]"}], 
   RowBox[{"2", " ", "\[Rho]"}]]}]], "Output",
 CellChangeTimes->{
  3.981912411740879*^9, {3.981912450327713*^9, 3.9819124640095673`*^9}, {
