 RowBox[{"Expectation", "[", 
  RowBox[{
   RowBox[{"1", "-", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SubscriptBox["\[Pi]", "jk"]}], ")"}], "\[CapitalKappa]"]}], ",", 
