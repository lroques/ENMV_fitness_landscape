Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Pinfcalc", "=", 
     RowBox[{"fs", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"1", "-", 
         RowBox[{
          RowBox[{"\[DoubleStruckCapitalP]", "[", 
           OverscriptBox["EST", "_"], "]"}], 
          RowBox[{"\[DoubleStruckCapitalP]", "[", 
           OverscriptBox["SV", "_"], "]"}], 
          RowBox[{"\[DoubleStruckCapitalP]", "[", 
           RowBox[{
            OverscriptBox["DN", "_"], ",", 
            OverscriptBox["EST", "_"]}], "]"}]}]}], "/.", "probas"}], ",", 
       "conds"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Pinf", "=", 
     RowBox[{"1", "-", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "q"}], 
        RowBox[{"(", 
         RowBox[{"r", "+", "\[Nu]", 
          RowBox[{"(*", 
           RowBox[{
            SqrtBox[
             RowBox[{
              RowBox[{"2", "\[Nu]"}], "+", "1"}]], "-", "1"}], "*)"}], "+", 
          SqrtBox[
           RowBox[{
            RowBox[{"2", "\[Nu]"}], "+", 
            SuperscriptBox["r", "2"]}]]}], ")"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fs", "[", 
      RowBox[{
       RowBox[{"Pinf", "==", "Pinfcalc"}], ",", 
       RowBox[{"conds", "&&", "#"}]}], "]"}], "&"}], "/@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"r", ">", "0"}], ",", 
      RowBox[{"r", "<", "0"}]}], "}"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fs", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], "==", 
        RowBox[{"Limit", "[", 
         RowBox[{
          RowBox[{"Pinf", "/", "Pinfcalc"}], ",", 
