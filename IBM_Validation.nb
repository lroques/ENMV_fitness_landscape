 RowBox[{
  RowBox[{"\[DoubleStruckCapitalP]", "[", "EST", "]"}], "=", 
  RowBox[{
   RowBox[{"1", "-", 
    RowBox[{"\[DoubleStruckCapitalP]", "[", 
