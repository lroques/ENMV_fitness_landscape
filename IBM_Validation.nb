     SubscriptBox["n", 
      RowBox[{"0", ",", "k"}]], ">", "0"}], "&&", 
    RowBox[{
     SubscriptBox["\[CapitalNu]", "0"], ">", "0"}], "&&", 
    RowBox[{"0", "<", 
     SubscriptBox["p", "k"], "<", "1"}], "&&", 
