Cell[BoxData[{
 RowBox[{
  RowBox[{"pp", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SubscriptBox["R", "k"], "\[Rule]", "2"}], ",", 
      RowBox[{"n", "->", "2"}], ",", 
      RowBox[{"\[Alpha]", "->", "1"}], ",", 
      RowBox[{"q", "->", "2"}], ",", 
      RowBox[{"U", "->", "2"}], ",", 
      RowBox[{"\[Rho]", "\[Rule]", 
       FractionBox[
        SuperscriptBox[
         SubscriptBox["R", "k"], "2"], "2"]}], ",", 
      RowBox[{"xD", "\[Rule]", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{
          SqrtBox["\[Delta]"], "-", "1"}], ")"}]}]}], ",", 
      RowBox[{"\[Delta]", "->", 
       FractionBox[
        SuperscriptBox["#", "2"], 
        SuperscriptBox[
         SubscriptBox["R", "k"], "2"]]}], ",", 
      RowBox[{"\[Theta]", "\[Rule]", 
       FractionBox["n", "2"]}], ",", 
      RowBox[{"\[Psi]", "->", "Hypergeometric0F1Regularized"}]}], "}"}], 
    "&"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dmax", "=", "5"}], ";", 
  RowBox[{"rge", "=", 
   RowBox[{"{", 
    RowBox[{
     SuperscriptBox["10", 
      RowBox[{"-", "5"}]], ",", "1"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
