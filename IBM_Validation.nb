760c015cc003"],

Cell[TextData[{
 "\[DoubleStruckCapitalP] (infection)  by a strain j from host j (pheno ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["x",
      FontWeight->"Bold",
      FontSlant->"Plain"], "j"], "\[TildeTilde]", 
    SubscriptBox[
     StyleBox["o",
      FontWeight->"Bold",
      FontSlant->"Plain"], "j"]}], TraditionalForm]],ExpressionUUID->
  "f3c6c0b3-93bf-334d-9ce1-bd49a6253ea4"],
 ")  inoculated into  target  host  k "
}], "Text",
 CellChangeTimes->{{3.981803051572504*^9, 3.9818030807415504`*^9}, {
  3.981803560895937*^9, 3.9818035699101887`*^9}, {3.981804111657741*^9, 
  3.981804144747074*^9}, {3.981804258468586*^9, 3.9818042634870014`*^9}, {
  3.981804297786965*^9, 3.9818043372883625`*^9}},
 Background->RGBColor[
  1, 1, 0],ExpressionUUID->"ded07fb2-dff1-7344-8999-b2feea21f6c5"],

Cell[BoxData[{
 StyleBox["definitions",
  FontWeight->"Bold"], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox["\[Xi]", "k"], "=", 
   RowBox[{
    FractionBox[
     SubsuperscriptBox["r", "k", "max"], 
     SubscriptBox["v", "k"]], " ", ":", " ", 
    FractionBox["1", 
     RowBox[{
      RowBox[{
      "stochastic", " ", "variance", " ", "in", " ", "host", " ", "k"}], ",", 
      " ", 
      RowBox[{"in", " ", "rescaled", " ", "time"}]}]]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox["q", "k"], "=", 
   RowBox[{
    SubscriptBox["\[CapitalNu]", "0"], 
    SubscriptBox["\[Xi]", "k"]}]}], " ", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    SubsuperscriptBox["r", 
     RowBox[{"j", ",", "k"}], "*"], "=", 
    RowBox[{
     RowBox[{"1", "-", 
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          StyleBox[
           SubscriptBox[
            StyleBox["x",
             FontWeight->"Bold"], 
            StyleBox["j",
             FontWeight->"Plain"]],
           FontWeight->"Bold"], "-", 
          SubscriptBox[
           StyleBox["o",
            FontWeight->"Bold"], "k"]}], ")"}], "2"], 
       SubsuperscriptBox["R", "k", "2"]]}], " ", "=", 
     RowBox[{
      FractionBox[
       SubscriptBox["r", 
        RowBox[{"j", ",", "k"}]], 
       SubsuperscriptBox["r", "k", "max"]], " ", ":", " ", 
      RowBox[{
      "growth", " ", "rate", " ", "of", " ", "parent", " ", "j", " ", "in", 
       " ", "host", " ", "k"}]}]}]}], ",", " ", 
   RowBox[{"in", " ", "rescaled", " ", "time", " ", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["t", "*"], "=", 
      RowBox[{
       SubsuperscriptBox["r", "k", "max"], " ", "t"}]}], ")"}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalPi]", "[", 
     RowBox[{"j", ",", "k"}], "]"}], "=", 
    RowBox[{
     RowBox[{"\[DoubleStruckCapitalE]", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[CapitalTheta]", "[", "\[Rho]", "]"}], "\[Rho]"}], "|", 
       RowBox[{"parent", " ", 
        StyleBox[
         SubscriptBox[
          StyleBox["x",
           FontWeight->"Bold"], "j"],
         FontWeight->"Bold"]}]}], "]"}], " ", ":", " ", 
     RowBox[{"\[Proportional]", " ", 
