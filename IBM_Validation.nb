Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pp", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"R", "\[Rule]", "1.5"}], ",", 
      RowBox[{"\[Rho]", "\[Rule]", 
       FractionBox[
        SuperscriptBox["R", "2"], "2"]}], ",", 
      RowBox[{"xD", "\[Rule]", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{
          SqrtBox["\[Delta]"], "-", "1"}], ")"}]}]}], ",", 
      RowBox[{"\[Delta]", "->", 
       FractionBox[
        SuperscriptBox["d", "2"], 
        SuperscriptBox["R", "2"]]}], ",", 
      RowBox[{"\[Theta]", "\[Rule]", 
       FractionBox["n", "2"]}], ",", 
      RowBox[{"n", "->", "3"}], ",", 
      RowBox[{"\[Psi]", "->", "Hypergeometric0F1Regularized"}]}], "}"}], 
    "&"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dmin", "=", "0"}], ";", 
  RowBox[{"dmax", "=", "4.5"}], ";", 
  RowBox[{"rge", "=", 
   RowBox[{"{", 
    RowBox[{
     SuperscriptBox["10", 
      RowBox[{"-", "4"}]], ",", "1"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListLogPlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"d", ",", 
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"y", " ", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{
               RowBox[{"-", "\[Rho]"}], 
               RowBox[{"(", 
                RowBox[{"1", "-", "y", "+", "\[Delta]"}], ")"}]}]], " ", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"1", "-", "y"}], ")"}], 
              RowBox[{"\[Theta]", "-", "1"}]], " ", 
             SuperscriptBox["\[Rho]", "\[Theta]"], " ", 
             RowBox[{"\[Psi]", "[", 
              RowBox[{"\[Theta]", ",", 
               RowBox[{
                SuperscriptBox["\[Rho]", "2"], 
                RowBox[{"(", 
                 RowBox[{"1", "-", "y"}], ")"}], " ", "\[Delta]"}]}], " ", 
              "]"}]}], "//.", 
            RowBox[{"pp", "[", "d", "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"y", ",", "0", ",", "1"}], "}"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"d", ",", "dmin", ",", "dmax", ",", "0.2"}], "}"}]}], "]"}], 
     ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Darker", "[", "Orange", "]"}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{"All", ",", "rge"}], "}"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["d", 
         RowBox[{"j", ",", "k"}]], ",", 
        RowBox[{"\[CapitalPi]", "[", 
         RowBox[{"j", ",", "k"}], "]"}]}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"LineLegend", "[", 
       RowBox[{"{", "\"\<exact\>\"", "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"LogPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Min", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             FractionBox[
              SqrtBox["2"], 
              RowBox[{
               SqrtBox["\[Pi]"], " ", 
               SubscriptBox["R", "k"]}]], "+", " ", 
             RowBox[{
              SuperscriptBox["\[ExponentialE]", 
               FractionBox[
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   FractionBox["n", 
                    RowBox[{"2", 
                    SubscriptBox["R", "k"]}]], "+", " ", 
                   SubscriptBox["d", 
                    RowBox[{"j", ",", "k"}]], "-", 
                   SubscriptBox["R", "k"]}], ")"}], "2"], "2"]], " ", 
              RowBox[{"Erfc", "[", 
               RowBox[{
                FractionBox["1", 
                 SqrtBox["2"]], 
                RowBox[{"(", 
                 RowBox[{
                  FractionBox["n", 
                   RowBox[{"2", 
                    SubscriptBox["R", "k"]}]], "+", 
                  SubscriptBox["d", 
                   RowBox[{"j", ",", "k"}]], "-", 
                  SubscriptBox["R", "k"]}], ")"}]}], "]"}], " ", 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                FractionBox[
                 SubscriptBox["d", 
                  RowBox[{"j", ",", "k"}]], 
                 SubscriptBox["R", "k"]], "-", 
                FractionBox["n", 
                 RowBox[{"2", " ", 
                  SubsuperscriptBox["R", "k", "2"]}]]}], ")"}]}]}], ")"}], 
           " ", 
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox[
              SubscriptBox["R", "k"], 
              SubscriptBox["d", 
               RowBox[{"j", ",", "k"}]]], ")"}], 
            RowBox[{
             FractionBox[
              RowBox[{"n", "-", "1"}], "2"], " "}]], 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{
             RowBox[{"-", 
              FractionBox["1", "2"]}], " ", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                SubscriptBox["d", 
                 RowBox[{"j", ",", "k"}]], "-", 
                SubscriptBox["R", "k"]}], ")"}], "2"]}]]}], ",", 
          RowBox[{
           RowBox[{
            FractionBox["1", "2"], " ", 
            RowBox[{"(", 
             RowBox[{"\[Mu]", "+", 
              RowBox[{
               SuperscriptBox["\[ExponentialE]", 
                RowBox[{"-", 
                 FractionBox[
                  SuperscriptBox["\[Mu]", "2"], 
                  RowBox[{"2", " ", 
                   SuperscriptBox["\[Sigma]", "2"]}]]}]], " ", 
               SqrtBox[
                FractionBox["2", "\[Pi]"]], " ", "\[Sigma]"}], "+", 
              RowBox[{"\[Mu]", " ", 
               RowBox[{"Erf", "[", 
                FractionBox["\[Mu]", 
                 RowBox[{
                  SqrtBox["2"], " ", "\[Sigma]"}]], "]"}]}]}], ")"}]}], "/.", 
           RowBox[{"{", " ", 
            RowBox[{
             RowBox[{"\[Mu]", "->", 
              RowBox[{"1", "-", 
               FractionBox[
                RowBox[{
                 SubsuperscriptBox["d", 
                  RowBox[{"j", ",", "k"}], "2"], "+", "n"}], 
                SubsuperscriptBox["R", "k", "2"]]}]}], " ", ",", " ", 
             RowBox[{"\[Sigma]", "->", 
              SqrtBox[
               FractionBox[
                RowBox[{
                 RowBox[{"2", " ", "n"}], "+", 
                 RowBox[{"4", " ", 
                  SubsuperscriptBox["d", 
                   RowBox[{"j", ",", "k"}], "2"]}]}], 
                SubsuperscriptBox["R", "k", "4"]]]}]}], "}"}]}]}], "}"}], 
        "]"}], "/.", 
       RowBox[{
        SubscriptBox["R", "k"], "->", "R"}]}], "//.", 
      RowBox[{"pp", "[", 
       SubscriptBox["d", 
        RowBox[{"j", ",", "k"}]], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["d", 
        RowBox[{"j", ",", "k"}]], ",", "dmin", ",", "dmax"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"Blue", ",", 
         RowBox[{"Opacity", "[", "0.5", "]"}]}], "}"}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"LineLegend", "[", 
       RowBox[{"{", 
        RowBox[{
        "\"\<Min[Laplace,Gaussian]\>\"", ",", 
         "\"\<Matching moment Gaussian Approx\>\""}], "}"}], "]"}]}]}], "]"}],
    ",", 
   RowBox[{"LogPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[CapitalTheta]", "[", 
       RowBox[{"d", "-", "R"}], "]"}], "//.", 
      RowBox[{"pp", "[", "1", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"d", ",", "dmin", ",", "dmax"}], "}"}], ",", 
