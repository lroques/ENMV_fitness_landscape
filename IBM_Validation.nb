Cell[CellGroupData[{

Cell["consistency  with  previous  results  in  the  limit", "Subsubsection",
 CellChangeTimes->{{3.981989043856428*^9, 
  3.981989050281101*^9}},ExpressionUUID->"840ca7e2-f77e-b54d-9be1-\
3c00ab6aa0f7"],

Cell[BoxData[{
 RowBox[{"we", " ", "retrieve", " ", "our", " ", "former", " ", "formulas", 
  " ", "if", " ", "we", " ", "assume", " ", "\[Nu]", 
  RowBox[{"<<", "1"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"for", " ", "ER", " ", "from", " ", 
   RowBox[{"subcriticals", ":", " ", 
    RowBox[{"1", "-", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "q"}], " ", "\[Nu]", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         FractionBox["1", "r"]}], ")"}]}]]}]}]}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"for", " ", "establishment", " ", "of", " ", 
   RowBox[{"supercritical", ":", 
    RowBox[{"1", "-", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "2"}], " ", "q", " ", "r"}]]}]}]}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"where", " ", "q"}], "=", 
   SubscriptBox["q", "k"]}], ",", " ", 
  RowBox[{"\[Nu]", "=", 
   RowBox[{
    RowBox[{"2", "U", " ", 
     RowBox[{"\[CapitalPi]", "[", 
      RowBox[{"j", ",", "k"}], "]"}], " ", "and", " ", "r"}], "=", 
    SubsuperscriptBox["r", 
     RowBox[{"j", ",", "k"}], "*"]}]}]}]}], "Text",
 CellChangeTimes->{{3.981988503617584*^9, 3.981988550144167*^9}, {
   3.981988653413639*^9, 3.981988656428393*^9}, {3.9819886937329197`*^9, 
   3.981988698748318*^9}, 3.981988737823261*^9, {3.981988983102539*^9, 
