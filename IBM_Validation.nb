Cell[BoxData[
 RowBox[{
  RowBox[{"we", " ", 
   RowBox[{"approximate", ":", 
    RowBox[{
     RowBox[{"h", "[", "x", "]"}], "\[TildeTilde]", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"x", " ", "\[Theta]"}], "2"]}]], " ", "x", " ", "to", " ", 
      "get", " ", "an", " ", "explicit", " ", "approximate", " ", 
      "expression"}]}], ":", "\[IndentingNewLine]", 
    RowBox[{"\[CapitalPi]", "[", 
     RowBox[{"i", ",", "k"}], "]"}]}]}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"K", 
     RowBox[{
      SubsuperscriptBox["\[Integral]", "0", "2"], 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", "4"]}], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "+", "xD"}], ")"}], "2"], " ", "\[Rho]"}]], " ", 
       RowBox[{"h", "[", "x", "]"}], 
       RowBox[{"\[DifferentialD]", "x"}]}]}]}], "\[TildeTilde]", 
    RowBox[{"K", 
     RowBox[{
      SubsuperscriptBox["\[Integral]", "0", "\[Infinity]"], 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", "4"]}], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "+", "xD"}], ")"}], "2"], " ", "\[Rho]"}]], " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"x", " ", "\[Theta]"}], "2"]}]], " ", "x", " ", 
       RowBox[{"\[DifferentialD]", "x"}]}]}]}]}], "=", 
   FractionBox[
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         SuperscriptBox["xD", "2"], " ", "\[Rho]"}], "4"]}]], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", 
        FractionBox["xD", "2"]}], ")"}], 
      RowBox[{
       FractionBox["1", "2"], "-", "\[Theta]"}]], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", 
        SqrtBox["\[Rho]"]}], "-", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         FractionBox[
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"\[Theta]", "+", 
             RowBox[{"xD", " ", "\[Rho]"}]}], ")"}], "2"], 
          RowBox[{"4", " ", "\[Rho]"}]]], " ", 
        SqrtBox["\[Pi]"], " ", 
        RowBox[{"(", 
         RowBox[{"\[Theta]", "+", 
          RowBox[{"xD", " ", "\[Rho]"}]}], ")"}], " ", 
        RowBox[{"Erfc", "[", 
         FractionBox[
          RowBox[{"\[Theta]", "+", 
           RowBox[{"xD", " ", "\[Rho]"}]}], 
          RowBox[{"2", " ", 
           SqrtBox["\[Rho]"]}]], "]"}]}]}], ")"}]}], 
    RowBox[{"2", " ", 
     SqrtBox["\[Pi]"], " ", "\[Rho]"}]]}]}]], "Text",
 CellChangeTimes->{{3.981957776174059*^9, 3.9819578259135838`*^9}, {
   3.9819579151366825`*^9, 3.981957915820898*^9}, 3.9819580257498293`*^9, {
   3.98195840717917*^9, 
   3.981958410562797*^9}},ExpressionUUID->"dc976219-0e2b-5541-90cf-\
b8236ad15255"],

