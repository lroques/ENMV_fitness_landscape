Cell[CellGroupData[{

Cell["Computation  of  \[CapitalPi][j, k]", "Subsubsection",
 CellChangeTimes->{{3.982246794924473*^9, 
  3.9822468019837646`*^9}},ExpressionUUID->"576cdb5a-7af4-8342-8412-\
e163a118dc01"],

Cell[BoxData[
 RowBox[{
  RowBox[{"matching", " ", "moment", " ", 
   RowBox[{"gaussian", ":", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"r", "'"}], "~", 
      RowBox[{"N", "[", 
       RowBox[{"\[Mu]", ",", "\[Sigma]"}], "]"}]}], "\[Implies]", 
     RowBox[{"\[CapitalPi]", "[", 
      RowBox[{"j", ",", "k"}], "]"}]}]}]}], "=", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   RowBox[{"(", 
    RowBox[{"\[Mu]", "+", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", 
        FractionBox[
         SuperscriptBox["\[Mu]", "2"], 
         RowBox[{"2", " ", 
          SuperscriptBox["\[Sigma]", "2"]}]]}]], " ", 
      SqrtBox[
       FractionBox["2", "\[Pi]"]], " ", "\[Sigma]"}], "+", 
     RowBox[{"\[Mu]", " ", 
      RowBox[{"Erf", "[", 
       FractionBox["\[Mu]", 
        RowBox[{
         SqrtBox["2"], " ", "\[Sigma]"}]], "]"}]}]}], ")"}]}]}]], "Text",
 CellChangeTimes->{{3.9819614984723797`*^9, 
  3.9819615365463486`*^9}},ExpressionUUID->"a935ccc1-0560-2d42-9f56-\
0b8eb5d5247c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Expectation", "[", 
  RowBox[{
   RowBox[{"r", " ", 
    RowBox[{"\[CapitalTheta]", "[", "r", "]"}]}], ",", 
   RowBox[{"r", "\[Distributed]", 
    RowBox[{"NormalDistribution", "[", 
     RowBox[{"\[Mu]", ",", "\[Sigma]"}], "]"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9819614695041943`*^9, 3.98196149284256*^9}},
 CellLabel->
  "In[1290]:=",ExpressionUUID->"67b2c788-0492-d34a-b724-9e6a52f42910"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "2"], " ", 
  RowBox[{"(", 
   RowBox[{"\[Mu]", "+", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"-", 
       FractionBox[
        SuperscriptBox["\[Mu]", "2"], 
        RowBox[{"2", " ", 
         SuperscriptBox["\[Sigma]", "2"]}]]}]], " ", 
     SqrtBox[
      FractionBox["2", "\[Pi]"]], " ", "\[Sigma]"}], "+", 
    RowBox[{"\[Mu]", " ", 
     RowBox[{"Erf", "[", 
      FractionBox["\[Mu]", 
       RowBox[{
        SqrtBox["2"], " ", "\[Sigma]"}]], "]"}]}]}], ")"}]}]], "Output",
 CellChangeTimes->{3.9819614945062733`*^9},
 CellLabel->
  "Out[1290]=",ExpressionUUID->"2afc9e42-ab25-cf46-8d74-1ec556654b43"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"moments", " ", "from", " ", "the", " ", "exact", " ", 
   RowBox[{"distribution", ":", " ", "\[Mu]"}]}], "=", 
  RowBox[{
   RowBox[{"1", "-", 
    RowBox[{
     FractionBox[
      RowBox[{
       SubsuperscriptBox["d", 
        RowBox[{"j", ",", "k"}], "2"], "+", "n"}], 
      SubsuperscriptBox["R", "k", "2"]], " ", "and", " ", "\[Sigma]"}]}], "=", 
   SqrtBox[
    FractionBox[
     RowBox[{
      RowBox[{"2", " ", "n"}], "+", 
      RowBox[{"4", " ", 
       SubsuperscriptBox["d", 
        RowBox[{"j", ",", "k"}], "2"]}]}], 
     SubsuperscriptBox["R", "k", "4"]]]}]}]], "Text",
 CellChangeTimes->{{3.981961541692366*^9, 3.981961556551325*^9}, {
   3.981962300861738*^9, 3.981962383104742*^9}, 3.981962423809931*^9, {
