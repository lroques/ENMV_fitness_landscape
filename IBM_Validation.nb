f1b4e91f5c17"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"fs", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"1", "-", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "q"}], " ", "\[Nu]", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         FractionBox["1", "r"]}], ")"}]}]]}], "==", 
    RowBox[{"1", "-", 
     RowBox[{"Exp", "[", 
      RowBox[{"nls", "[", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"1", "-", "Pinf"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Nu]", ",", "0", ",", "1"}], "}"}]}], "]"}], "]"}]}]}], 
   ",", 
   RowBox[{"r", "<", "0"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"fs", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"1", "-", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "2"}], " ", "q", " ", "r"}]]}], "==", 
    RowBox[{"1", "-", 
     RowBox[{"Exp", "[", 
      RowBox[{"nls", "[", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"1", "-", "Pinf"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Nu]", ",", "0", ",", "0"}], "}"}]}], "]"}], "]"}]}]}], 
   ",", 
