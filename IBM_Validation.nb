Cell[BoxData[{
 RowBox[{
  RowBox[{"fixed", " ", "burst", " ", 
   RowBox[{"size", " ", ":", "R"}]}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"B", "+", "1"}], "\[Implies]", " ", 
    RowBox[{"f", "[", "z", "]"}]}], "=", 
   RowBox[{
    RowBox[{"\[DoubleStruckCapitalE]", "[", 
     SuperscriptBox["z", "R"], "]"}], "=", 
    SuperscriptBox["z", 
     RowBox[{"B", "+", "1"}]]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solution", " ", 
   RowBox[{"P", "[", 
    RowBox[{"z", ",", "t"}], "]"}]}], "=", 
  RowBox[{
   RowBox[{"\[DoubleStruckCapitalE]", "[", 
    SuperscriptBox["z", 
     SubscriptBox["n", "t"]], "]"}], "=", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"B", " ", "\[Lambda]", " ", "t"}]], 
       RowBox[{"(", 
        RowBox[{
