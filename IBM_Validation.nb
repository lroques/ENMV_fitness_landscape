Cell[BoxData[{
 RowBox[{
  RowBox[{"I0", "=", 
   RowBox[{"fs", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"K", 
        RowBox[{
         SubsuperscriptBox["\[Integral]", "0", "\[Infinity]"], 
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", 
             FractionBox["1", "4"]}], " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"x", "+", "xD"}], ")"}], "2"], " ", "\[Rho]"}]], " ", 
          "x", " ", 
          RowBox[{"\[DifferentialD]", "x"}]}]}]}], "/.", 
       RowBox[{"K", "->", 
        FractionBox[
         RowBox[{" ", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "+", 
              FractionBox["xD", "2"]}], ")"}], 
            RowBox[{
             FractionBox["1", "2"], "-", "\[Theta]"}]], 
           SqrtBox["\[Rho]"]}]}], 
         RowBox[{"2", " ", 
          SqrtBox["\[Pi]"]}]]}]}], "//", "po"}], ",", 
     RowBox[{
      RowBox[{"\[Rho]", ">", "0"}], "&&", 
      RowBox[{"xD", ">", "0"}], "&&", 
      RowBox[{"\[Theta]", ">=", 
       RowBox[{"1", "/", "2"}]}]}]}], "]"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"zeroth", " ", "order", " ", 
     RowBox[{"h", "[", "x", "]"}]}], "\[TildeTilde]", " ", "x"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"I1", "=", 
  RowBox[{"fs", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"K", 
       RowBox[{
        SubsuperscriptBox["\[Integral]", "0", "\[Infinity]"], 
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "4"]}], " ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"x", "+", "xD"}], ")"}], "2"], " ", "\[Rho]"}]], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"-", 
           FractionBox[
            RowBox[{"x", " ", "\[Theta]"}], "2"]}]], " ", "x", " ", 
         RowBox[{"\[DifferentialD]", "x"}]}]}]}], "/.", 
      RowBox[{"K", "->", 
       FractionBox[
        RowBox[{" ", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "+", 
             FractionBox["xD", "2"]}], ")"}], 
           RowBox[{
            FractionBox["1", "2"], "-", "\[Theta]"}]], 
          SqrtBox["\[Rho]"]}]}], 
        RowBox[{"2", " ", 
         SqrtBox["\[Pi]"]}]]}]}], "//", "po"}], ",", 
    RowBox[{
     RowBox[{"\[Rho]", ">", "0"}], "&&", 
     RowBox[{"xD", ">", "0"}], "&&", 
     RowBox[{"\[Theta]", ">=", 
      RowBox[{"1", "/", "2"}]}]}]}], "]"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"first", " ", "order", " ", 
     RowBox[{"h", "[", "x", "]"}]}], "\[TildeTilde]", 
