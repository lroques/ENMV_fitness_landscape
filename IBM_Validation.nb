  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Delta]", ",", 
       SuperscriptBox["\[Sigma]", "2"]}], "}"}], "/.", "moments"}], "/.", 
