  3.994418263481745*^9}},ExpressionUUID->"7c1ae2c0-ee5e-eb4b-9ae2-\
3f6557580c63"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pars", "=", 
   RowBox[{
    RowBox[{"Thread", "/@", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SubscriptBox["d", "#"], "&"}], "/@", 
          RowBox[{"Range", "[", "2", "]"}]}], ")"}], "->", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}]}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SubscriptBox["\[Beta]", "#"], "&"}], "/@", 
          RowBox[{"Range", "[", "2", "]"}]}], ")"}], "->", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"BB", "-", "1"}], ")"}], 
         RowBox[{"{", 
          RowBox[{"1", ",", "1"}], "}"}]}]}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SubscriptBox["b", "#"], "&"}], "/@", 
          RowBox[{"Range", "[", "2", "]"}]}], ")"}], "->", 
        FractionBox[
         RowBox[{"{", 
          RowBox[{"1", ",", "1"}], "}"}], 
         RowBox[{"BB", "-", "1"}]]}], ",", 
       RowBox[{"u", "->", "0.0001"}], ",", 
       RowBox[{"BB", "->", "2"}], ",", 
       RowBox[{
        SubscriptBox["x", "0"], "->", "10"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            SubscriptBox["r", "#"], "->", 
            RowBox[{
             RowBox[{
              SubscriptBox["b", "#"], 
              SubscriptBox["\[Beta]", "#"]}], "-", 
             SubscriptBox["d", "#"]}]}], ",", 
           RowBox[{
            SubscriptBox["\[Sigma]", "#"], "->", 
            RowBox[{
             SubscriptBox["d", "#"], "+", 
             RowBox[{
              SubscriptBox["\[Beta]", "#"], 
              RowBox[{"(", 
               RowBox[{
                SubscriptBox["r", "#"], "+", 
                SubscriptBox["d", "#"]}], ")"}]}]}]}]}], "}"}], "&"}], "/@", 
        RowBox[{"Range", "[", "2", "]"}]}]}], "}"}]}], "//", "ft"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.994413409772402*^9, 3.9944134300127773`*^9}, {
