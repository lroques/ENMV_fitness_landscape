Cell["\<\
mutant count distribution: B=2 (Benchmark = Lea Couslon theory)\
\>", "Subsection",
 CellChangeTimes->{{3.9943929703493824`*^9, 3.994392974192364*^9}, {
  3.994393082165789*^9, 3.9943931083196545`*^9}, {3.994412403379833*^9, 
