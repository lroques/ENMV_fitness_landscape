Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nrep", "=", 
   RowBox[{"14", "*", "500"}]}], ";", 
  RowBox[{"Nmax", "=", 
   RowBox[{
    RowBox[{"Round", "[", 
     RowBox[{"0.1", "/", "u"}], "]"}], "//.", "pars"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sims0", "=", 
    RowBox[{"ParallelTable", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Reap", "[", 
        RowBox[{"NestWhile", "[", 
         RowBox[{"Iteration", ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "x0", ",", "pars"}], "}"}], ",", 
          RowBox[{
           RowBox[{"0", "<", 
            RowBox[{"Total", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "]"}], "<", "Nmax"}], "&"}]}], 
         "]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", "1"}], "]"}], "]"}], ",", "nrep"}], "]"}]}], ";"}], 
  "//", "AT"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sims", "=", 
   RowBox[{
    RowBox[{
