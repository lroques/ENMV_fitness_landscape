Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"means", "=", 
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"t", ",", 
          RowBox[{"Mean", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", "t", "]"}], "&"}], "/@", "tns"}], "]"}]}], 
         "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0.5", ",", "tmax", ",", "0.5"}], "}"}]}], "]"}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{
         SubscriptBox["x", "0"], "//.", "pars"}]}], "}"}]}], "]"}]}], ";"}], "//",
   "Quiet"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vars", "=", 
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"t", ",", 
          RowBox[{"Variance", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", "t", "]"}], "&"}], "/@", "tns"}], "]"}]}], 
         "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0.5", ",", "tmax", ",", "0.5"}], "}"}]}], "]"}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], "]"}]}], ";"}], "//", 
  "Quiet"}], "\[IndentingNewLine]", 
 RowBox[{"simplot", "=", 
  RowBox[{"ListLogPlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"means", ",", "vars"}], "}"}], ",", 
    RowBox[{"PlotStyle", "->", 
     RowBox[{"PointSize", "[", "0.0075", "]"}]}], ",", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{"1", ",", "All"}], "}"}]}], ",", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"Placed", "[", 
      RowBox[{
       RowBox[{"LineLegend", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[DoubleStruckCapitalE]", "[", 
            SubscriptBox["n", "t"], "]"}], ",", 
           RowBox[{"\[DoubleStruckCapitalV]", "[", 
            SubscriptBox["n", "t"], "]"}]}], "}"}], ",", 
         RowBox[{"LegendLabel", "->", 
          RowBox[{"StringForm", "[", 
           RowBox[{"\"\<`` simulations\>\"", ",", "nrep"}], "]"}]}]}], "]"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"0.2", ",", "0.8"}], "}"}]}], "]"}]}], ",", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{"time", ",", "moments"}], "}"}]}], ",", 
    RowBox[{"PlotLabel", "->", "title"}]}], "]"}]}]}], "Input",
