Cell[CellGroupData[{

Cell["run one  sim and plot it", "Subsubsection",
 CellChangeTimes->{{3.9943862770556736`*^9, 3.9943862799142056`*^9}, {
  3.9943868768060226`*^9, 3.9943868794450665`*^9}, {3.994391563174179*^9, 
  3.9943915672751102`*^9}},ExpressionUUID->"104a28e3-ff79-3443-9229-\
8e0d6c7dd7dc"],

Cell[TextData[{
 " run  simulation  until  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "t"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e63d5209-507e-214d-974f-4b7ddc0d19fd"],
 " = Nmax"
}], "Text",
 CellChangeTimes->{{3.9943836586109085`*^9, 3.994383663000286*^9}, {
   3.994383702136936*^9, 3.9943837092463703`*^9}, 3.9943841343898144`*^9, {
   3.994384307667513*^9, 3.994384307860916*^9}, 
   3.9943903810193863`*^9},ExpressionUUID->"7a5ed605-8588-f741-94ef-\
dc627b38d6da"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Nmax", "=", " ", 
    SuperscriptBox["10", "4"]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sim", "=", 
    RowBox[{
     RowBox[{"Reap", "[", 
      RowBox[{"NestWhile", "[", 
       RowBox[{"Iteration", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "x0", ",", "pars"}], "}"}], ",", 
        RowBox[{
         RowBox[{"0", "<", 
          RowBox[{"Total", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], "<", "Nmax"}], "&"}]}], 
       "]"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ";"}], "//", 
  "AT"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PrependTo", "[", 
    RowBox[{"sim", ",", 
     RowBox[{"ft", "[", 
      RowBox[{"{", 
       RowBox[{"0", ",", "x0"}], "}"}], "]"}]}], "]"}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"add", " ", "initial", " ", "state", " ", "state"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Tmax", "=", 
   RowBox[{"Max", "[", 
    RowBox[{"sim", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
  RowBox[{"nf", "=", 
   RowBox[{
    RowBox[{"Last", "[", "sim", "]"}], "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListLogPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"sim", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
     RowBox[{"sim", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}]}], "}"}], ",", 
   RowBox[{"Joined", "->", "True"}], ",", 
   RowBox[{"PlotStyle", "->", "Thick"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "Tmax"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.5", ",", "nf"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"PlotLabel", "->", 
    RowBox[{"StringForm", "[", 
     RowBox[{
     "\"\<\!\(\*SubscriptBox[StyleBox[\"\[CapitalNu]\",FontSlant->\"Italic\"],\
 \"0\"]\) \!\(\*StyleBox[\"u\",FontSlant->\"Italic\"]\) = ``\>\"", ",", 
      RowBox[{
       RowBox[{"Nmax", " ", "u"}], "//.", "pars"}]}], "]"}]}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.994392778400175*^9, 3.994392894557871*^9}, {
   3.99439306003454*^9, 3.994393062723818*^9}, {3.994402228301752*^9, 
