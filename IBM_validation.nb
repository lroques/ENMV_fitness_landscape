   RowBox[{
    OverscriptBox["X", "_"], "\[Rule]", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", "t", "}"}], ",", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"t", " ", 
         SubscriptBox["r", "1"]}]], " ", 
       SubscriptBox["x", "0"]}]}], "]"}]}], ",", 
