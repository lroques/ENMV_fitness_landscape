      RowBox[{"PlotLegends", "->", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"LineLegend", "[", 
          RowBox[{
          "{", "\"\<Lea - Coulson: \[DoubleStruckCapitalP][\[ScriptM] = k | k \
> 0] = \!\(\*FractionBox[\(1\), \(k + \*SuperscriptBox[\(k\), \
\(2\)]\)]\)\>\"", "}"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"0.6", ",", "0.8"}], "}"}]}], "]"}]}]}], "]"}]}], 
