Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"EMGF2", "=", 
   RowBox[{"Function", "[", 
    RowBox[{"z", ",", 
     RowBox[{"Mean", "[", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "mutantcounts2"}], " ", "z"}]], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MGFth", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"\[Beta]", " ", 
        SuperscriptBox["X", 
         RowBox[{
          RowBox[{"-", "1"}], "/", "\[Beta]"}]], " ", 
        RowBox[{"Hypergeometric2F1", "[", 
         RowBox[{
          FractionBox["1", "\[Beta]"], ",", 
          RowBox[{
           FractionBox["1", "\[Beta]"], "+", 
           FractionBox["1", 
            RowBox[{"1", "-", "c"}]]}], ",", 
          RowBox[{
           FractionBox["1", "\[Beta]"], "+", 
           FractionBox[
            RowBox[{
             RowBox[{"-", "2"}], "+", "c"}], 
            RowBox[{
             RowBox[{"-", "1"}], "+", "c"}]]}], ",", 
          RowBox[{"-", 
           FractionBox["1", "X"]}]}], "]"}]}], 
       RowBox[{"1", "+", "\[Beta]", "-", "c"}]], "/.", 
      RowBox[{"X", "->", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"z", " ", "\[Beta]"}]], "-", "1"}]}]}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"c", "->", 
        RowBox[{"1", "-", 
         FractionBox[
          SubscriptBox["r", "2"], 
          SubscriptBox["r", "1"]]}]}], ",", 
       RowBox[{"\[Beta]", "->", 
        SubscriptBox["\[Beta]", "1"]}]}], "}"}]}], "//.", "pars"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"leacoulsonplotMGF", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"EMGF2", "[", "z", "]"}], ",", "MGFth", ",", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", "z"}]], ",", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["\[ExponentialE]", "z"], "-", "1"}], ")"}], " ", 
        RowBox[{"Log", "[", 
         RowBox[{"1", "+", 
          FractionBox["1", 
           RowBox[{
            SuperscriptBox["\[ExponentialE]", "z"], "-", "1"}]]}], 
         "]"}]}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", "0", ",", "5"}], "}"}], ",", 
    RowBox[{"PlotStyle", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"op", "[", "0.5", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"Dashed", ",", "Red"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Dotted", ",", "Black"}], "}"}], ",", 
       RowBox[{"op", "[", "0.5", "]"}]}], "}"}]}], ",", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"LineLegend", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"StringForm", "[", 
         RowBox[{"\"\<`` simulations\>\"", ",", 
          RowBox[{"NumberForm", "[", 
           RowBox[{"Length", "[", "mutantcounts", "]"}], "]"}]}], "]"}], ",", 
        "\"\<exact MGF\>\"", ",", 
        "\"\<\!\(\*SuperscriptBox[\(\[ExponentialE]\), \(-\\\ z\)]\)\>\"", 
        ",", "\"\<Lea Coulson (B=2)\>\""}], "}"}], "]"}]}], ",", 
    RowBox[{"PlotLabel", "->", "title"}], ",", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}]}], ",", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{"z", ",", 
       RowBox[{
        SubscriptBox["\[ScriptCapitalM]", "\[ScriptM]"], "[", "z", "]"}]}], 
      "}"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.994414957807431*^9, 3.994415037532078*^9}, {
