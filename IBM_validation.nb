Cell["to  make  a  proper  step plot for one sim", "Text",
 CellChangeTimes->{{3.9943912221840553`*^9, 3.9943912317796364`*^9}, {
  3.9943926237538414`*^9, 
  3.9943926251909256`*^9}},ExpressionUUID->"c3417fa0-68b4-9f41-8b3b-\
0af4deebd2fa"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"niceplot", "=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"data", ",", "format", ",", "lgd"}], "}"}], ",", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", "stepData", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"stepData", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"data", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
                 RowBox[{"data", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"data", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"i", "+", "1"}], ",", "1"}], "]"}], "]"}], ",", 
                 RowBox[{"data", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "}"}]}], "}"}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", 
               RowBox[{
                RowBox[{"Length", "[", "data", "]"}], "-", "1"}]}], "}"}]}], 
            "]"}], ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Generate", " ", "the", " ", "exact", " ", "horizontal", " ", "and", 
          " ", "vertical", " ", "corner", " ", "points"}], "*)"}], "\n", 
        RowBox[{"stepData", "=", 
         RowBox[{"Append", "[", 
          RowBox[{"stepData", ",", 
           RowBox[{"Last", "[", "data", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ListLogPlot", "[", 
         RowBox[{"stepData", ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<Time (t)\>\"", ",", "\"\<Population Size\>\""}], 
            "}"}]}], ",", 
          RowBox[{"Joined", "->", "True"}], ",", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"{", "format", "}"}]}], ",", 
          RowBox[{"PlotLegends", "->", "lgd"}], ",", 
          RowBox[{"PlotRange", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "Tmax"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0.5", ",", "nf"}], "}"}]}], "}"}]}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"mutantdynplot", "=", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"niceplot", "[", 
     RowBox[{
      RowBox[{"sim", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", 
        RowBox[{"op", "[", "0.5", "]"}]}], "}"}], ",", 
      RowBox[{"Placed", "[", 
       RowBox[{
        RowBox[{"LineLegend", "[", 
         RowBox[{"{", "\"\<WT\>\"", "}"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"0.2", ",", "0.8"}], "}"}]}], "]"}]}], "]"}], ",", 
    RowBox[{"niceplot", "[", 
     RowBox[{
      RowBox[{"sim", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Darker", "[", "Red", "]"}], ",", 
        RowBox[{"op", "[", "0.5", "]"}]}], "}"}], ",", 
