Cell[BoxData[
 RowBox[{"extract", " ", "final", " ", "mutant", " ", "counts", " ", "upon", 
  " ", "sampling", " ", 
  RowBox[{"(", 
   RowBox[{"when", " ", "total", " ", "pop", " ", "reaches", " ", 
    SubscriptBox[
     StyleBox["N",
      FontSlant->"Italic"], "0"]}], ")"}]}]], "Text",
 CellChangeTimes->{{3.994412740112276*^9, 3.994412746463913*^9}, {
  3.99441290563748*^9, 
  3.994412942961624*^9}},ExpressionUUID->"08198510-de3f-c44b-9730-\
3b4a2bbd749f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"allcounts", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Last", "[", "#", "]"}], "&"}], "/@", "sims"}], ")"}], "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "3"}], "]"}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"all", " ", "final", " ", "m"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mutantcounts", "=", 
    RowBox[{"Select", "[", 
     RowBox[{"allcounts", ",", 
      RowBox[{
       RowBox[{"#", ">", "0"}], "&"}]}], "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "those", " ", "with", " ", "at", " ", "least", " ", "one", " ", "mutant"}],
    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"title", "=", 
    RowBox[{"StringForm", "[", 
     RowBox[{
     "\"\<`` sims , \[Beta] = ``, \
\!\(\*SubscriptBox[StyleBox[\"N\",FontSlant->\"Italic\"], \"0\"]\) \
\!\(\*StyleBox[\"u\",FontSlant->\"Italic\"]\) = `` , c = ``, d = ``\>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"Length", "[", "mutantcounts", "]"}], "]"}], ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        SubscriptBox["\[Beta]", "1"], "//.", "pars"}], "]"}], ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"Nmax", " ", "u"}], "//.", "pars"}], "]"}], ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"1", "-", 
         FractionBox[
          SubscriptBox["r", "2"], 
          SubscriptBox["r", "1"]]}], "//.", "pars"}], "]"}], ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        SubscriptBox["d", "1"], "//.", "pars"}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"counts", " ", "for", " ", "each", " ", "discrete", " ", "m"}], 
    "=", "k"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kNk", "=", 
   RowBox[{"Tally", "[", "mutantcounts", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"leacoulsonplotPk", "=", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"DiscretePlot", "[", 
     RowBox[{
      FractionBox[
       RowBox[{"Length", "[", "mutantcounts", "]"}], 
       RowBox[{"k", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}]}]], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "0", ",", "10"}], "}"}], ",", 
      RowBox[{"Filling", "->", "None"}], ",", 
      RowBox[{"Ticks", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", "10"}], "]"}], ",", "Automatic"}], "}"}]}], ",", 
      RowBox[{"PlotLabel", "->", "title"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", "Red", "}"}]}], ",", 
      RowBox[{"PlotMarkers", "->", "\"\<+\>\""}], ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "10"}], "}"}], ",", "All"}], "}"}]}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"LineLegend", "[", 
          RowBox[{
          "{", "\"\<Lea - Coulson: \[DoubleStruckCapitalP][\[ScriptM] = k | k \
> 0] = \!\(\*FractionBox[\(1\), \(k + \*SuperscriptBox[\(k\), \
\(2\)]\)]\)\>\"", "}"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"0.6", ",", "0.8"}], "}"}]}], "]"}]}]}], "]"}], ",", 
    RowBox[{"ListPlot", "[", 
     RowBox[{"kNk", ",", 
      RowBox[{"Filling", "->", "Axis"}], ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "10"}], "}"}], ",", "All"}], "}"}]}], ",", 
      RowBox[{"Ticks", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Range", "[", "5", "]"}], ",", "Automatic"}], "}"}]}], ",", 
      RowBox[{"PlotLabel", "->", "title"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"op", "[", "0.5", "]"}]}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"LineLegend", "[", 
          RowBox[{"{", 
           RowBox[{"StringForm", "[", 
            RowBox[{"\"\<simulations B = ``\>\"", ",", 
             RowBox[{
              RowBox[{
               SubscriptBox["\[Beta]", "1"], "+", "1"}], "//.", "pars"}]}], 
            "]"}], "}"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"0.45", ",", "0.6"}], "}"}]}], "]"}]}]}], "]"}]}], 
   "]"}]}]}], "Input",
