              SubscriptBox["b", "#"], 
              SubscriptBox["\[Beta]", "#"]}], "-", 
             SubscriptBox["d", "#"]}]}], ",", 
           RowBox[{
            SubscriptBox["\[Sigma]", "#"], "->", 
            RowBox[{
             SubscriptBox["d", "#"], "+", 
