Cell[BoxData[{
 RowBox[{
  RowBox[{"fellerpars", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Nu]", "->", 
      FractionBox[
       RowBox[{"\[ScriptC]", " ", 
        SubscriptBox["x", "0"]}], 
       RowBox[{"1", "-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", 
           SubscriptBox["r", "1"]}], " ", "t"}]]}]]}], ",", 
     RowBox[{"\[Eta]", "->", 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"t", " ", 
          SubscriptBox["r", "1"]}]], "-", "1"}], "\[ScriptC]"]}], ",", 
     RowBox[{"\[ScriptC]", "->", 
      FractionBox[
       RowBox[{"4", 
        SubscriptBox["r", "1"]}], 
       SubscriptBox["\[Sigma]", "1"]]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptF]\[ScriptX]", "=", 
   FractionBox[
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"\[ScriptX]", "+", 
         RowBox[{"\[Eta]", " ", "\[Nu]"}]}], 
        RowBox[{"2", " ", "\[Eta]"}]]}]], " ", "\[Nu]", " ", 
     RowBox[{"Hypergeometric0F1", "[", 
      RowBox[{"2", ",", 
       FractionBox[
        RowBox[{"\[ScriptX]", " ", "\[Nu]"}], 
        RowBox[{"4", " ", "\[Eta]"}]]}], "]"}]}], 
    RowBox[{"4", " ", "\[Eta]"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"theoryplot", "=", 
   RowBox[{"LogLogPlot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[ScriptF]\[ScriptX]", "//.", "fellerpars"}], "//.", 
        "pars"}], "/.", 
       RowBox[{"t", "->", "ts"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[ScriptX]", ",", 
       SuperscriptBox["10", "2"], ",", 
       SuperscriptBox["10", "5"]}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"Dashed", ",", "Thick"}], "}"}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        SuperscriptBox["10", 
         RowBox[{"-", "6"}]], ",", "All"}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"Placed", "[", 
       RowBox[{
        RowBox[{"LineLegend", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<\>\"", ",", "\"\<\>\"", ",", "\"\<\>\""}], "}"}], ",", 
          RowBox[{"LegendLabel", "->", "\"\<Feller theory\>\""}]}], "]"}], 
        ",", "Top"}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"pdfplot", "=", 
  RowBox[{"Show", "[", 
   RowBox[{"simplot", ",", "theoryplot"}], "]"}]}]}], "Input",
